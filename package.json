{
  "name": "pi-handoff",
  "version": "0.2.0",
  "description": "Compact the session into a handoff document for another agent",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "logic.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.0",
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
